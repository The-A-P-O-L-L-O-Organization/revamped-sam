{
  "name": "revamped-sam",
  "version": "0.2.0",
  "description": "SAM - The Software Automatic Mouth (revamped)",
  "author": "CodeMaster013 <mgs008@outlook.com>",
  "private": false,
  "main": "dist/samjs.js",
  "module": "dist/samjs.esm.js",
  "types": "dist/samjs.d.ts",
  "exports": {
    ".": {
      "types": "./dist/samjs.d.ts",
      "import": "./dist/samjs.esm.js",
      "require": "./dist/samjs.common.js",
      "default": "./dist/samjs.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "rollup -w -c build/config.js --environment TARGET:dev",
    "dev:cjs": "rollup -w -c build/config.js --environment TARGET:cjs",
    "dev:esm": "rollup -w -c build/config.js --environment TARGET:esm",
    "guessnum-dev": "rollup -w -c build/config.js --environment TARGET:guessnum-demo-dev",
    "prod": "rollup -w -c build/config.js --environment TARGET:prod",
    "predev": "node build/types.js",
    "predev:cjs": "node build/types.js",
    "predev:esm": "node build/types.js",
    "preguessnum-dev": "node build/types.js",
    "preprod": "node build/types.js",
    "build": "node build/build.js",
    "build:types": "node build/types.js",
    "lint": "oxlint",
    "test": "pnpm t-1 && pnpm t-2 && pnpm t-3 && pnpm t-4 && pnpm t-5 && pnpm t-6 && pnpm t-7 && pnpm t-8",
    "t-1": "mocha --check-leaks --reporter progress --require ./test/babel-register.js --timeout 30000 test/minimum-tests.spec.js test/index.spec.js test/types/*.spec.js",
    "t-2": "mocha --check-leaks --reporter progress --require ./test/babel-register.js --timeout 30000 test/reciter/tests-1.spec.js",
    "t-3": "mocha --check-leaks --reporter progress --require ./test/babel-register.js --timeout 30000 test/reciter/tests-2.spec.js",
    "t-4": "mocha --check-leaks --reporter progress --require ./test/babel-register.js --timeout 30000 test/reciter/tests-3.spec.js",
    "t-5": "mocha --check-leaks --reporter progress --require ./test/babel-register.js --timeout 30000 test/reciter/tests-4.spec.js",
    "t-6": "mocha --check-leaks --reporter progress --require ./test/babel-register.js --timeout 30000 test/reciter/regression.spec.js",
    "t-7": "mocha --check-leaks --reporter progress --require ./test/babel-register.js --timeout 30000 test/parser/*.spec.js",
    "t-8": "mocha --check-leaks --reporter progress --require ./test/babel-register.js --timeout 30000 test/renderer/*.spec.js",
    "cov": "c8 --reporter text --reporter lcov pnpm test"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/plugin-transform-runtime": "^7.0.0",
    "@babel/plugin-transform-typescript": "^7.0.0",
    "@babel/preset-env": "^7.0.0",
    "@babel/register": "^7.0.0",
    "@babel/runtime": "^7.0.0",
    "c8": "^10.0.0",
    "@rollup/plugin-buble": "^1.0.0",
    "@rollup/plugin-replace": "^6.0.0",
    "chai": "^4.5.0",
    "mocha": "^11.0.0",
    "rollup": "^4.0.0",
    "oxlint": "^1.89.0",
    "terser": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],

  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-A-P-O-L-L-O-Organization/revamped-sam.git"
  },
  "keywords": [
    "speech",
    "synthesis",
    "retro",
    "c64"
  ],
  "license": "SEE LICENSE IN README.md",
  "bugs": {
    "url": "https://github.com/The-A-P-O-L-L-O-Organization/revamped-sam/issues"
  },
  "homepage": "https://github.com/The-A-P-O-L-L-O-Organization/revamped-sam#readme"
}
