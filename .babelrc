{
  "presets": [
    ["@babel/preset-env", {
        "targets": {
          "browsers": ["last 2 versions", "safari >= 7"]
        },
        "modules": "commonjs"
      }
    ]
  ],
  "plugins": [
    "@babel/plugin-transform-runtime",
    // Parses/erases TypeScript syntax; no-ops on plain .js files.
    "@babel/plugin-transform-typescript"
  ],
  "comments": false,
  "ignore": [
    "dist/*.js"
  ],
  "compact" : true
}
