{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "declarationDir": "build/.dts",
    "outDir": "build/.ts",
    "rootDir": "src",
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/index.ts"],
  "exclude": ["node_modules", "build", "web", "dist", "test", "docs"]
}
